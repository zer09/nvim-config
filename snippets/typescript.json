{
  "Express Req, Res": {
    "prefix": "eaf",
    "body": [
      "private async ${1:funcName}(req:Request, res:Response) {\n\t${0}\n}"
    ],
    "descrption": "Function that will be used for Express request response function."
  },
  "Service function": {
    "prefix": "sf",
    "body": [
      "async ${1:funcName}(${3:paramaters}) {",
      "\ttry {\n\t${0}\n\t} catch(error) {\n",
      "\tlogError('${2:serviceName}:${1:funcName}', error);",
      "\treturn unhandledFailedResult();\n\t}\n}"
    ],
    "descrption": "This will be used for creating service function."
  }
}
